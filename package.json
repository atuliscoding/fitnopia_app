{
  "name": "fitnopia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:auth": "ts-node scripts/test-auth.ts",
    "db:types": "supabase gen types typescript --project-id \"your-project-id\" > types/supabase.ts",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:generate-types": "supabase gen types typescript --local > types/supabase.ts",
    "db:update-schema": "node --loader ts-node/esm scripts/update-schema.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node --loader ts-node/esm prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.9.1",
    "@google/generative-ai": "^0.24.1",
    "@headlessui/react": "^1.7.19",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.50.0",
    "@upstash/ratelimit": "^1.0.0",
    "@upstash/redis": "^1.35.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "next": "14.2.29",
    "next-auth": "^4.24.7",
    "openai": "^5.1.1",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.15.3",
    "tailwind-merge": "^3.3.0",
    "uuid": "^9.0.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.11.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^9.0.0",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.29",
    "postcss": "^8",
    "prisma": "^5.0.0",
    "supabase": "^1.148.6",
    "tailwindcss": "^3.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "type": "module"
}
